{
  "permissions": {
    "allow": [
      "Bash(<exact test command>)",
      "Bash(<exact lint command>)",
      "Bash(<exact type-check command>)"
    ],
    "deny": [
      "Read(<project-specific secret file or folder>)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/forbidden_patterns.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_changed_file.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
