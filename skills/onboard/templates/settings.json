{
  "permissions": {
    "allow": [
      "Bash(<exact test command>)",
      "Bash(<exact lint command>)",
      "Bash(<exact type-check command>)"
    ],
    "deny": [
      "Read(<project-specific secret file or folder>)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/<lint-changed-file>.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
